# Google Cloud / Vertex AI Configuration
GOOGLE_CLOUD_PROJECT=mglaesle-sandbox
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# Optional: For local AI Studio runs instead of Vertex AI
# GOOGLE_API_KEY=stored-in-secret-manager

# Storage & Persistence
RETRO_DB_PATH=./data/retro_campaigns.db
RETRO_ARTIFACTS_DIR=./data/artifacts
ADK_SESSION_DB_URL=sqlite+aiosqlite:///./data/adk_sessions.db

# Observability & PII Redaction
OTEL_SERVICE_NAME=team-retrospective-agent
ENABLE_CLOUD_DLP=false
ENABLE_SECRET_MANAGER=false

# Email Delivery Mode: "local_preview" saves .eml/.html files; "smtp" sends real email
EMAIL_DELIVERY_MODE=local_preview
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
# SMTP_PASSWORD is fetched from Secret Manager when ENABLE_SECRET_MANAGER=true
